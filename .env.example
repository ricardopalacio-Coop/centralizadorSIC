# ==============================================================================
# CENTRALIZADOR SIC - CONFIGURAÇÃO DE AMBIENTE (PRODUÇÃO / DESENVOLVIMENTO)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVIDOR HTTP / API
# ------------------------------------------------------------------------------
PORT=3005
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. BANCO DE DADOS MYSQL 8.0 (DEDICADO)
# ------------------------------------------------------------------------------
# No Docker Compose, use 'db' ou 'host.docker.internal' conforme a topologia.
# Em bare-metal / localhost, use 'localhost' ou o IP do servidor de banco.
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=sua_senha_segura_aqui
DB_NAME=centralizador_sic_db

# ------------------------------------------------------------------------------
# 3. SEGURANÇA E AUTENTICAÇÃO (JWT & SUPERADMIN)
# ------------------------------------------------------------------------------
# Gere uma chave aleatória e segura para produção (ex: openssl rand -base64 32)
JWT_SECRET=defina_uma_chave_secreta_longa_e_aleatoria_para_producao

# Credenciais do SuperAdmin inicial (criado na primeira inicialização do banco)
INITIAL_ADMIN_EMAIL=ricardo.palacio@coopedu.com.br
INITIAL_ADMIN_PASSWORD=sua_senha_admin_forte

# ------------------------------------------------------------------------------
# 4. INTEGRAÇÃO SIC CORE & M2M COOPEDU
# ------------------------------------------------------------------------------
SIC_API_URL=https://core.coopedu.app.br
SIC_CLIENT_ID=seu_client_id_sic_core
SIC_CLIENT_SECRET=seu_client_secret_sic_core

# ------------------------------------------------------------------------------
# 5. MÓDULO DE ADESÕES E DESLIGAMENTOS
# ------------------------------------------------------------------------------
DESLIGAMENTO_BASE_URL=https://c.coopedu.com.br
DESLIGAMENTO_API_KEY=sua_api_key_desligamento

# ------------------------------------------------------------------------------
# 6. INTEGRAÇÃO GOOGLE DRIVE API (OAUTH 2.0 / FICHAS CADASTRAIS)
# ------------------------------------------------------------------------------
GOOGLE_DRIVE_FOLDER_ID=id_da_pasta_de_fichas_cadastrais
GOOGLE_DRIVE_DESLIGAMENTO_FOLDER_ID=id_da_pasta_de_fichas_desligamento
GOOGLE_OAUTH_CLIENT_ID=seu_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=seu_google_oauth_client_secret
GOOGLE_OAUTH_REFRESH_TOKEN=seu_google_oauth_refresh_token
